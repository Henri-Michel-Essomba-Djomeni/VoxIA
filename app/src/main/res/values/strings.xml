    <string name="permission_rationale_audio_title">Autoriser le microphone</string>
    <string name="permission_rationale_audio_message">VOXIA a besoin du microphone pour comprendre vos commandes vocales. Sans cette autorisation, l\'application ne peut pas fonctionner.</string>
    <string name="permission_rationale_camera_title">Autoriser la caméra</string>
    <string name="permission_rationale_camera_message">VOXIA a besoin de la caméra pour lire un document, identifier un objet, scanner un produit ou traduire un texte visible.</string>
    <string name="permission_rationale_contacts_title">Autoriser les contacts</string>
    <string name="permission_rationale_contacts_message">VOXIA a besoin d\'accéder à vos contacts pour trouver le numéro de la personne que vous voulez appeler. Vos contacts ne sont ni envoyés ni stockés ailleurs que sur votre téléphone.</string>
    <string name="permission_rationale_notifications_title">Autoriser les notifications</string>
    <string name="permission_rationale_notifications_message">VOXIA utilise une notification persistante pour indiquer quand le service vocal est actif. Sans cette autorisation, Android peut masquer cette information.</string>
